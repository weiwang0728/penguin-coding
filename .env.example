# Existing Anthropic-compatible model configuration
API_KEY=your-model-api-key
BASE_URL=https://api.anthropic.com
MODEL_ID=your-model-id

# Optional Langfuse integration. Disabled unless explicitly enabled.
PENGUIN_OBSERVABILITY_ENABLED=false
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-your-project-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-project-secret-key
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_RELEASE=local

# metadata_only: timings, usage, IDs, states; no prompt/response/tool content
# redacted: opt in to bounded input/output with common secret redaction
PENGUIN_OBSERVABILITY_CONTENT=metadata_only
PENGUIN_OBSERVABILITY_MAX_CHARS=8000
